FROM node:22-alpine
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
ARG NEXT_PUBLIC_MOCK=1
ARG NEXT_PUBLIC_FHIR_SANDBOX=0
ARG NEXT_PUBLIC_FHIR_REFERRAL=0
ARG NEXT_PUBLIC_LAB_SANDBOX=0
ARG NEXT_PUBLIC_KIN_TOOLS=0
ARG KINSIGHT_API_URL=http://localhost:8000
ENV NEXT_PUBLIC_MOCK=$NEXT_PUBLIC_MOCK
ENV NEXT_PUBLIC_FHIR_SANDBOX=$NEXT_PUBLIC_FHIR_SANDBOX
ENV NEXT_PUBLIC_FHIR_REFERRAL=$NEXT_PUBLIC_FHIR_REFERRAL
ENV NEXT_PUBLIC_LAB_SANDBOX=$NEXT_PUBLIC_LAB_SANDBOX
ENV NEXT_PUBLIC_KIN_TOOLS=$NEXT_PUBLIC_KIN_TOOLS
ENV KINSIGHT_API_URL=$KINSIGHT_API_URL
RUN npm run build
EXPOSE 3000
CMD ["npm", "start"]
