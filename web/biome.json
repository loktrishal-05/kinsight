{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"files": {
		"includes": [
			"app/**",
			"components/**",
			"lib/**",
			"tests/**",
			"e2e/**",
			"e2e-live/**",
			"!lib/fixtures/**",
			"!**/*.css"
		]
	},
	"formatter": {
		"enabled": false
	},
	"assist": {
		"enabled": false
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"a11y": {
				"preset": "recommended",
				"useButtonType": "warn",
				"useSemanticElements": "warn"
			},
			"suspicious": {
				"noArrayIndexKey": "warn",
				"noExplicitAny": "warn",
				"useIterableCallbackReturn": "warn"
			},
			"correctness": {
				"useExhaustiveDependencies": "warn"
			},
			"style": {
				"noNonNullAssertion": "off"
			}
		}
	}
}
