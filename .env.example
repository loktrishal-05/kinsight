DATABASE_URL=postgresql+psycopg://kinsight:kinsight-demo@localhost:5432/kinsight
REDIS_URL=redis://localhost:6379/0
POSTGRES_PASSWORD=kinsight-demo
# Demo auth: fictional personas only. Secrets must be distinct and at least 32 bytes.
KINSIGHT_DEMO=1
KINSIGHT_DEMO_AUTH=1
KINSIGHT_TOKEN_SECRET=change-me-change-me-change-me-change-me
KINSIGHT_AUDIT_SALT=change-me-too-change-me-too-change-me-too
NEXT_PUBLIC_MOCK=1
# Opt-in synthetic lab feed. Set the same distinct secret in the local mock lab process.
KINSIGHT_LAB_SANDBOX=0
KINSIGHT_LAB_SIGNING_SECRET=
NEXT_PUBLIC_LAB_SANDBOX=0
# Optional trusted FHIR R4 fixture endpoint. Example http://127.0.0.1:8088/fhir
KINSIGHT_FHIR_SANDBOX_URL=
NEXT_PUBLIC_FHIR_SANDBOX=0
# Optional private synthetic FHIR referral receiver (ServiceRequest and Task).
KINSIGHT_FHIR_REFERRAL_URL=
NEXT_PUBLIC_FHIR_REFERRAL=0
NEXT_PUBLIC_KIN_TOOLS=0
# Optional model (Mode B / tracing); the default Mode A needs none
LLM_MODEL=
LLM_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
